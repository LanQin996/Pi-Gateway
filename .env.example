# Copy to .env and replace the placeholder passwords before deployment.
# Single active gateway; Redis shares metadata, not live sockets or admission limits.
# Four supported stacks (database/Redis ports are not published to the host):
#   docker compose up -d --build
#   docker compose -f compose.yaml -f compose.postgres.yaml up -d --build
#   docker compose -f compose.yaml -f compose.redis.yaml up -d --build
#   docker compose -f compose.yaml -f compose.postgres.yaml -f compose.redis.yaml up -d --build
# `docker compose down` preserves data. Add --volumes ONLY to destroy that stack's data.
# PostgreSQL passwords in the DSN below must use URI-safe characters.

# Local Compose settings
PI_GATEWAY_IMAGE=pi-gateway:local
PI_GATEWAY_PORT=8317
PI_GATEWAY_ADMIN_PASSWORD=change-me
TZ=UTC

# PostgreSQL overlay (compose.postgres.yaml)
POSTGRES_USER=pi_gateway
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=pi_gateway

# Redis overlay (compose.redis.yaml); namespace shared by this deployment only.
PI_GATEWAY_REDIS_PREFIX=pi-gateway:

# Optional Codex catalog discovery, only for accounts with linked Codex credentials.
# Generation still uses upstream.base_url; these do not change the quota endpoint.
# HTTP(S) local/custom gateways are allowed, but not api.openai.com, URL userinfo,
# fragments or credential query parameters. Never put tokens in this URL.
# Export these to the gateway process; Compose does not forward them automatically.
PI_GATEWAY_CODEX_BASE_URL=https://chatgpt.com/backend-api
# Local reference version, not a latest-version claim. Empty uses the default;
# otherwise use 1-64 ASCII letters/digits or . _ + -, starting with a letter/digit.
PI_GATEWAY_CODEX_CLIENT_VERSION=0.153.4
# Automatic model catalog sync: default 3600 seconds; 0 disables, minimum 30.
PI_GATEWAY_MODELS_REFRESH_INTERVAL_SECONDS=3600

# Optional dedicated integration-test service URLs. Export these when running Go
# tests; Compose does not expose those ports and does not export .env into the host.
# CI provides disposable services and fails if any required integration test skips.
PI_GATEWAY_TEST_POSTGRES_DSN=postgres://pi_gateway:change-me-postgres@127.0.0.1:5432/pi_gateway?sslmode=disable
PI_GATEWAY_TEST_REDIS_URL=redis://127.0.0.1:6379/15
