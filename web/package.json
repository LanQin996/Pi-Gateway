{
  "name": "pi-gateway-web",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "check:i18n": "node check-i18n.mjs",
    "check:quota": "node check-quota-cost.mjs",
    "check:billing": "node check-usage-billing.mjs",
    "check:capture": "node check-capture-diff.mjs && node check-capture-inspection.mjs",
    "check:rules": "node check-rules.mjs",
    "check:simulation": "node check-rule-simulation.mjs",
    "test:e2e": "playwright test",
    "check:ui-accessibility": "node check-ui-accessibility.mjs",
    "check:sonar-regressions": "node check-sonar-regressions.mjs"
  },
  "dependencies": {
    "@vue-flow/core": "^1.48.2",
    "diff": "^9.0.0",
    "echarts": "^6.1.0",
    "lucide-vue-next": "^0.469.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
